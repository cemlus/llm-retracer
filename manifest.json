{
    "manifest_version": 3,
    "name": "LLM Retracer",
    "version": "1.0.0",
    "description": "Jump back to your messages in any LLM chat",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*"
    ],
    "content_scripts": [
      {
        "matches": [
          "https://chatgpt.com/*",
          "https://chat.openai.com/*",
          "https://claude.ai/*",
          "https://gemini.google.com/*"
        ],
        "js": ["src/content/index.tsx"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["fonts/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }